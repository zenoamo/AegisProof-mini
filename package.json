{
  "name": "aegisproof-mini",
  "version": "0.1.0",
  "description": "Experimental minimal Groth16 proof, verification, and integrity line. Not AegisProof v2.",
  "type": "module",
  "private": true,
  "bin": {
    "aegisproof-mini": "./src/cli/index.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prove": "node src/cli/index.js prove",
    "verify": "node src/cli/index.js verify",
    "integrity": "node src/cli/index.js integrity",
    "key-info": "node src/cli/index.js key-info",
    "keys:check": "node src/cli/index.js keys-check",
    "test": "node --test --test-force-exit \"tests/**/*.test.js\"",
    "test:positive": "node --test --test-force-exit \"tests/positive/**/*.test.js\"",
    "test:negative": "node --test --test-force-exit \"tests/negative/**/*.test.js\"",
    "test:tamper": "node --test --test-force-exit \"tests/tamper/**/*.test.js\"",
    "test:authenticity": "node --test --test-force-exit \"tests/authenticity/**/*.test.js\"",
    "sepolia:export-verifier": "node experimental/sepolia/scripts/export-verifier.js",
    "sepolia:test": "node experimental/sepolia/scripts/run-hardhat-test.cjs",
    "sepolia:deploy": "hardhat run experimental/sepolia/scripts/deploy.cjs --network sepolia --config experimental/sepolia/hardhat.config.cjs",
    "sepolia:verify": "node experimental/sepolia/scripts/verify-call.cjs",
    "sepolia:verify:tx": "node experimental/sepolia/scripts/verify-tx.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.6"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "ethers": "^6.15.0",
    "hardhat": "^2.29.1"
  }
}
